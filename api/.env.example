# Vehicle Diagnostics API Environment Configuration
# Copy this file to .env and update values as needed

# Environment
ENVIRONMENT=development
DEBUG=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Database Configuration
DB_TYPE=sqlite
# For PostgreSQL:
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=vehicle_diagnostics

# OBD-II Adapter Settings
OBD_ADAPTER_TYPE=ELM327
OBD_CONNECTION_TIMEOUT=30
OBD_READ_TIMEOUT=10
OBD_FAST_MODE=false

# Bluetooth Settings
BT_DEVICE_NAME=OBDII
# BT_ADDRESS=XX:XX:XX:XX:XX:XX
BT_PIN=1234

# Firebase/Firestore Settings
FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CREDENTIALS_PATH=/path/to/service-account-key.json
FIREBASE_COLLECTION_PREFIX=dev

# InfluxDB Settings
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=vehicle-diagnostics
INFLUXDB_BUCKET=sensor-data

# Security Settings
SECRET_KEY=your-super-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=["*"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]

# Logging Settings
LOG_LEVEL=INFO
# LOG_FILE_PATH=/var/log/vehicle-diagnostics/api.log

# Performance Settings
MAX_CONCURRENT_SESSIONS=10
DATA_RETENTION_DAYS=730